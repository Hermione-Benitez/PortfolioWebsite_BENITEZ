@{
    ViewData["Title"] = "About";
    ViewData["Description"] = "About Hermione Benitez — BSIT student, aspiring UI/UX Designer, Graphic Designer, Frontend Developer, QA, and System Architect.";
}

@section Styles {
<style>
    body {
        background-image: url('/images/bg.webp');
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center center;
        background-attachment: fixed;
    }

    /* ===== HERO PARALLAX SCENE ===== */
    .Parallax {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        height: 100svh;
        min-height: 540px;
        width: 100%;
        overflow: hidden;
    }

    .Parallax img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        object-fit: cover;
        will-change: transform;
    }

    #bg {
        z-index: 1;
    }

    #purpleflare {
        z-index: 2;
        animation: flare-breathe 7s ease-in-out infinite alternate;
    }

    @@keyframes flare-breathe {
        0% { opacity: 0.82; }
        100% { opacity: 1; }
    }

    #text {
        position: relative;
        z-index: 3;
        font-family: var(--font-display);
        font-size: clamp(1.85rem, 8.8vw, 8.8rem);
        font-weight: 800;
        letter-spacing: 0.02em;
        color: #ffffff;
        white-space: nowrap;
        text-shadow: 0 12px 45px rgba(12, 0, 32, 0.75), 0 0 38px rgba(208, 170, 255, 0.48);
        user-select: none;
        will-change: transform, opacity;
        margin: 0;
        animation: hero-fade-in 0.95s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    #hermisolo {
        z-index: 4;
        object-position: center center;
        filter: drop-shadow(0 20px 45px rgba(0, 0, 0, 0.55));
        animation: hero-fade-in 1.15s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
    }

    @@keyframes hero-fade-in {
        0% {
            opacity: 0;
            filter: blur(8px);
        }
        100% {
            opacity: 1;
            filter: blur(0);
        }
    }

    #transition {
        z-index: 5;
    }

    .hero-bottom-stack {
        position: absolute;
        bottom: clamp(22px, 5vh, 52px);
        left: 50%;
        transform: translateX(-50%);
        z-index: 6;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        width: max-content;
        max-width: calc(100vw - 28px);
        pointer-events: none;
    }

    .hero-top-badge {
        text-align: center;
    }

    .hero-top-badge .eyebrow-pill {
        white-space: nowrap;
        font-size: clamp(0.64rem, 2.2vw, 0.82rem);
        padding: 6px 14px;
    }

    .hero-scroll-cue {
        pointer-events: auto;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #f3e8ff;
        text-decoration: none;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        padding: 9px 20px;
        border-radius: 999px;
        background: rgba(14, 5, 30, 0.62);
        border: 1px solid rgba(208, 170, 255, 0.34);
        backdrop-filter: blur(12px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
        transition: background-color 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
    }

    .hero-scroll-cue:hover {
        color: #ffffff;
        background: rgba(99, 0, 165, 0.72);
        border-color: rgba(224, 86, 253, 0.65);
        transform: translateY(-2px);
    }

    .hero-scroll-cue svg {
        animation: scroll-bob 1.8s ease-in-out infinite;
    }

    @@media (max-height: 640px) {
        .hero-bottom-stack {
            bottom: 16px;
            gap: 10px;
        }
    }

    @@media (max-width: 420px) {
        .hero-top-badge .eyebrow-pill {
            white-space: normal;
            text-align: center;
            line-height: 1.35;
        }
    }

    @@keyframes scroll-bob {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(4px); }
    }

    /* ===== INTRO & ROLE TICKER ===== */
    .title {
        position: relative;
        z-index: 6;
        text-align: center;
        padding: 56px 20px 92px;
        scroll-margin-top: 72px;
        color: #ffffff;
        width: 100%;
        background: linear-gradient(180deg, #6300a5 0%, #3d0070 42%, #130526 82%, rgba(6, 2, 15, 0.92) 100%);
    }

    .title-inner {
        max-width: 920px;
        margin: 0 auto;
    }

    #Hi {
        font-family: var(--font-display);
        font-size: clamp(1.9rem, 4vw, 3.2rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 18px;
        color: #ffffff;
    }

    .text-changer {
        font-size: clamp(1.15rem, 2.6vw, 2rem);
        font-weight: 700;
        margin: 0 auto 24px;
        display: inline-flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 12px;
    }

    .text-changer-prefix {
        margin: 0;
        color: #f4ebff;
    }

    .aspiringroles {
        position: relative;
        display: inline-block;
        max-width: calc(100vw - 32px);
        height: 1.7em;
        line-height: 1.7em;
        overflow: hidden;
        padding: 0 clamp(14px, 3vw, 22px);
        border-radius: 999px;
        background: rgba(14, 4, 30, 0.52);
        border: 1px solid rgba(224, 170, 255, 0.35);
        box-shadow: 0 10px 30px rgba(10, 0, 30, 0.42), inset 0 0 18px rgba(168, 85, 247, 0.18);
        backdrop-filter: blur(12px);
        -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
        mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
    }

    @@media (max-width: 480px) {
        .text-changer {
            font-size: clamp(1rem, 4.4vw, 1.35rem);
        }
    }

    .role-track {
        display: flex;
        flex-direction: column;
        animation: role-change 10s cubic-bezier(0.65, 0, 0.35, 1) infinite;
        will-change: transform;
    }

    .role {
        display: block;
        height: 1.7em;
        line-height: 1.7em;
        white-space: nowrap;
        font-weight: 800;
        color: #f8edff;
        text-shadow: 0 0 22px rgba(224, 86, 253, 0.55);
    }

    @@keyframes role-change {
        0%, 15% { transform: translate3d(0, 0, 0); }
        20%, 35% { transform: translate3d(0, -16.6667%, 0); }
        40%, 55% { transform: translate3d(0, -33.3333%, 0); }
        60%, 75% { transform: translate3d(0, -50%, 0); }
        80%, 95% { transform: translate3d(0, -66.6667%, 0); }
        100% { transform: translate3d(0, -83.3333%, 0); }
    }

    .intro-bio {
        font-size: clamp(0.98rem, 1.3vw, 1.12rem);
        color: #eadcff;
        max-width: 780px;
        margin: 0 auto 28px;
        line-height: 1.75;
    }

    .intro-stats {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-bottom: 30px;
    }

    .intro-stat-pill {
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        font-size: 0.86rem;
        font-weight: 600;
        color: #f8f5ff;
    }

    .intro-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
    }

    /* ===== BENTO SECTION ("Get to know her more") ===== */
    .hover-section {
        position: relative;
        z-index: 6;
        padding: 90px 20px 100px;
        background: linear-gradient(180deg, rgba(6, 2, 15, 0.94) 0%, rgba(16, 6, 36, 0.9) 55%, rgba(6, 2, 15, 0.85) 100%);
        text-align: center;
    }

    .section-header {
        max-width: 760px;
        margin: 0 auto 48px;
    }

    .bento-grid {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
    }

    .info-card {
        padding: 26px 24px;
        text-align: left;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        gap: 12px;
    }

    .bento-card--wide {
        grid-column: span 2;
        background: linear-gradient(135deg, rgba(99, 0, 165, 0.28), rgba(20, 8, 42, 0.82));
    }

    .bento-icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: rgba(168, 85, 247, 0.16);
        border: 1px solid rgba(208, 170, 255, 0.3);
        color: var(--orchid-glow);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .bento-tag {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--magenta-flare);
    }

    .info-card h3 {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
    }

    .info-card p {
        font-size: 0.95rem;
        line-height: 1.65;
        color: var(--text-secondary);
        margin: 0;
    }

    .color-swatch-row {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: auto;
        padding-top: 6px;
    }

    .swatch-dot {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.4);
    }

    @@media (max-width: 1024px) {
        .bento-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .bento-card--wide {
            grid-column: span 2;
        }
    }

    @@media (max-width: 600px) {
        .bento-grid {
            grid-template-columns: 1fr;
        }

        .bento-card--wide {
            grid-column: span 1;
        }
    }

    /* ===== SKILLS INFINITE MARQUEE ===== */
    .Skill-section {
        position: relative;
        z-index: 6;
        padding: 90px 0 80px;
        background: rgba(6, 2, 15, 0.62);
        backdrop-filter: blur(8px);
        text-align: center;
    }

    .Skill-section .section-header {
        padding: 0 20px;
    }

    .Skills {
        display: flex;
        gap: 0;
        overflow: hidden !important;
        scrollbar-width: none;
        -ms-overflow-style: none;
        padding: 32px 0 46px;
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    }

    .Skills::-webkit-scrollbar {
        display: none;
    }

    .skillgroup {
        display: flex;
        flex-shrink: 0;
        align-items: stretch;
        gap: 24px;
        padding-right: 24px;
        animation: spin 24s linear infinite;
        will-change: transform;
    }

    .Skills:hover .skillgroup {
        animation-play-state: paused;
    }

    .skill {
        flex: 0 0 300px;
        min-height: 290px;
        padding: 28px 24px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        gap: 12px;
        text-align: left;
        border-top: 2px solid rgba(208, 170, 255, 0.42);
    }

    .skill-badge {
        align-self: flex-start;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #f3e8ff;
        background: rgba(168, 85, 247, 0.22);
        border: 1px solid rgba(208, 170, 255, 0.3);
    }

    .skill h3 {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.35rem;
        color: #ffffff;
        margin: 0;
    }

    .skill p {
        font-size: 0.94rem;
        font-weight: 400;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.65;
    }

    @@keyframes spin {
        from { transform: translate3d(0, 0, 0); }
        to { transform: translate3d(-100%, 0, 0); }
    }

    .marquee-hint {
        color: var(--text-muted);
        font-size: 0.82rem;
        margin-top: 4px;
    }

    /* ===== CURRENT ROLES & RESPONSIBILITIES ===== */
    .roles-section {
        position: relative;
        z-index: 6;
        padding: 90px 20px;
        background: linear-gradient(180deg, rgba(6, 2, 15, 0.65), rgba(14, 5, 30, 0.85));
        text-align: center;
    }

    .roles-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 24px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .role-item {
        display: flex;
        flex-direction: column;
        text-align: left;
    }

    .role-item-image {
        position: relative;
        width: 100%;
        height: 270px;
        overflow: hidden;
        background: #140826;
    }

    .role-item-image::after {
        content: "";
        position: absolute;
        inset: auto 0 0 0;
        height: 45%;
        background: linear-gradient(180deg, transparent, rgba(16, 7, 32, 0.92));
        pointer-events: none;
    }

    .role-item-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 20%;
        display: block;
        transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .role-item:hover .role-item-image img {
        transform: scale(1.07);
    }

    .role-period-badge {
        position: absolute;
        bottom: 12px;
        left: 14px;
        z-index: 2;
        padding: 4px 11px;
        border-radius: 999px;
        background: rgba(10, 4, 24, 0.82);
        border: 1px solid rgba(208, 170, 255, 0.35);
        color: var(--orchid-glow);
        font-size: 0.74rem;
        font-weight: 700;
        backdrop-filter: blur(8px);
    }

    .role-item-details {
        padding: 20px 22px 24px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex-grow: 1;
    }

    .role-item-details h3 {
        font-family: var(--font-display);
        font-size: 1.08rem;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.35;
        margin: 0;
    }

    .role-item-details p {
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--text-secondary);
        margin: 0;
    }

    @@media (max-width: 1100px) {
        .roles-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .skill {
            flex: 0 0 260px;
            min-height: 260px;
            padding: 22px 20px;
        }

        .roles-grid {
            grid-template-columns: 1fr;
            max-width: 420px;
        }
    }

    /* ===== SAMPLE WORK VIDEO SHOWCASE ===== */
    .video-section {
        position: relative;
        z-index: 6;
        padding: 80px 20px 110px;
        background: rgba(6, 2, 15, 0.82);
    }

    .video-showcase-card {
        max-width: 1120px;
        margin: 0 auto;
        padding: clamp(24px, 4vw, 44px);
        display: grid;
        grid-template-columns: minmax(260px, 420px) 1fr;
        gap: clamp(24px, 4vw, 48px);
        align-items: center;
    }

    .video-frame {
        position: relative;
        border-radius: 22px;
        padding: 10px;
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.4), rgba(224, 86, 253, 0.2));
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 40px rgba(168, 85, 247, 0.28);
    }

    .video-frame video {
        width: 100%;
        display: block;
        border-radius: 16px;
        background: #080312;
    }

    .video-copy {
        text-align: left;
    }

    .video-copy h2 {
        font-family: var(--font-display);
        font-size: clamp(1.8rem, 3.2vw, 2.5rem);
        font-weight: 800;
        color: #ffffff;
        margin: 14px 0 12px;
    }

    .video-description {
        font-size: 1rem;
        color: var(--text-secondary);
        line-height: 1.75;
        margin-bottom: 22px;
    }

    .tool-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 28px;
    }

    .tool-chip {
        padding: 6px 14px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(208, 170, 255, 0.22);
        color: #e9d5ff;
        font-size: 0.84rem;
        font-weight: 600;
    }

    .video-cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
    }

    @@media (max-width: 860px) {
        .video-showcase-card {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .video-frame {
            max-width: 420px;
            margin: 0 auto;
        }

        .video-copy {
            text-align: center;
        }

        .tool-chip-row,
        .video-cta-row {
            justify-content: center;
        }
    }
</style>
}

<section class="Parallax" data-hero-section>
    <img src="~/images/bg.webp" alt="Background landscape" id="bg" />
    <img src="~/images/purpleflare.webp" alt="" id="purpleflare" />
    <h1 id="text">HERMIONE</h1>
    <img src="~/images/hermisolo.webp" alt="Hermione Benitez portrait" id="hermisolo" />
    <img src="~/images/transition.webp" alt="" id="transition" />
    <div class="hero-bottom-stack">
        <div class="hero-top-badge">
            <span class="eyebrow-pill"><span class="eyebrow-dot"></span> BSIT • Creative Designer • Developer</span>
        </div>
        <a href="#about-intro" class="hero-scroll-cue" aria-label="Scroll to introduction">
            <span>Scroll</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6"></path>
            </svg>
        </a>
    </div>
</section>

<section class="title" id="about-intro">
    <div class="title-inner" data-reveal="up">
        <h2 id="Hi">Hi! She's Hermione Benitez.</h2>
        <div class="text-changer">
            <p class="text-changer-prefix">An Aspiring</p>
            <div class="aspiringroles" aria-live="polite">
                <div class="role-track">
                    <span class="role">UI/UX Designer</span>
                    <span class="role">Graphic Designer</span>
                    <span class="role">Frontend Developer</span>
                    <span class="role">Quality Assurance</span>
                    <span class="role">System Architecture</span>
                    <span class="role" aria-hidden="true">UI/UX Designer</span>
                </div>
            </div>
        </div>
        <p class="intro-bio">
            She studies the field of Information Technology from 2023 – Present, combining creative digital craftsmanship with technical leadership.
            She has extensive experience across campus organizations focusing on creative visual media, and has led systems development as a Project Manager, Full Stack Developer, Database Manager, and System Architect.
        </p>
        <div class="intro-stats">
            <span class="intro-stat-pill">PUPQC BSIT (2023 – Present)</span>
            <span class="intro-stat-pill">9+ Organizational Roles</span>
            <span class="intro-stat-pill">13+ Published Artworks</span>
        </div>
        <div class="intro-actions">
            <a class="btn-glow" asp-controller="Home" asp-action="Portfolio">
                Explore Her Portfolio
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
            </a>
            <a class="btn-glass" asp-controller="Home" asp-action="Contact">Resume &amp; Contact</a>
        </div>
    </div>
</section>

<section class="hover-section">
    <div class="section-header" data-reveal="up">
        <span class="eyebrow-pill"><span class="eyebrow-dot"></span> Personal Profile</span>
        <h2 class="section-heading gradient-text mt-3">Get to know her more</h2>
        <p class="section-subtitle">Beyond the code and pixels—here are the values, roots, and inspirations that fuel Hermione's creativity.</p>
    </div>

    <div class="bento-grid">
        <article class="glass-card info-card" data-spotlight data-reveal="up" data-delay="0">
            <span class="bento-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </span>
            <span class="bento-tag">Origin</span>
            <h3>She's born in</h3>
            <p>October 25, 2005 at Quezon City, Philippines.</p>
        </article>

        <article class="glass-card info-card" data-spotlight data-reveal="up" data-delay="70">
            <span class="bento-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><path d="M2 2l7.586 7.586"></path></svg>
            </span>
            <span class="bento-tag">Passions</span>
            <h3>She has so many hobbies</h3>
            <p>Dancing, Singing, Drawing, Listening to music, Reading books, watching movies, and many more on the list.</p>
        </article>

        <article class="glass-card info-card bento-card--wide" data-spotlight data-reveal="up" data-delay="140">
            <span class="bento-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8l-6.2 4.5 2.4-7.4L2 9.4h7.6L12 2z"></path></svg>
            </span>
            <span class="bento-tag">Philosophy</span>
            <h3>Her life motto is</h3>
            <p>“Every day is a blessing and there’s so much that could happen in a day, so live your life to the fullest.”</p>
