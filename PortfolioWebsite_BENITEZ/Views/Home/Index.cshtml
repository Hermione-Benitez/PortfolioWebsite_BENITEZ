@section Scripts {
<script>
    (() => {
        const bg = document.getElementById('bg');
        const hermisolo = document.getElementById('hermisolo');
        const text = document.getElementById('text');
        const purpleflare = document.getElementById('purpleflare');
        const parallax = document.querySelector('.Parallax');

        if (!parallax) return;

        let scrollValue = window.scrollY || 0;
        let targetX = 0;
        let targetY = 0;
        let currentX = 0;
        let currentY = 0;
        let animatingPointer = false;

        function renderParallax() {
            const heroH = parallax.offsetHeight || window.innerHeight || 800;
            const progress = Math.min(1.2, Math.max(0, scrollValue / heroH));

            if (scrollValue <= heroH + 220) {
                if (bg) {
                    const bgScale = 1.05 + progress * 0.1;
                    bg.style.transform = `translate3d(${(currentX * -12).toFixed(2)}px, ${(scrollValue * 0.48 + currentY * -10).toFixed(2)}px, 0) scale(${bgScale.toFixed(3)})`;
                }
                if (purpleflare) {
                    const flareScale = 1.02 + progress * 0.08;
                    purpleflare.style.transform = `translate3d(${(currentX * 20).toFixed(2)}px, ${(scrollValue * 0.9 + currentY * 14).toFixed(2)}px, 0) scale(${flareScale.toFixed(3)})`;
                }
                if (text) {
                    const textScale = Math.max(0.84, 1 - progress * 0.14);
                    text.style.transform = `translate3d(${(scrollValue * 0.48 + currentX * 24).toFixed(2)}px, ${(scrollValue * 1.06 + currentY * 16).toFixed(2)}px, 0) scale(${textScale.toFixed(3)})`;
                    text.style.opacity = Math.max(0.08, 1 - progress * 1.05).toFixed(3);
                }
                if (hermisolo) {
                    const portraitScale = 1 + progress * 0.04;
                    hermisolo.style.transform = `translate3d(${(scrollValue * -0.95 + currentX * -16).toFixed(2)}px, ${(scrollValue * 0.72 + currentY * -8).toFixed(2)}px, 0) scale(${portraitScale.toFixed(3)})`;
                }
            }
        }

        function tickPointer() {
            const dx = targetX - currentX;
            const dy = targetY - currentY;
            currentX += dx * 0.09;
            currentY += dy * 0.09;
            renderParallax();

            if (Math.abs(dx) > 0.002 || Math.abs(dy) > 0.002) {
                window.requestAnimationFrame(tickPointer);
            } else {
                currentX = targetX;
                currentY = targetY;
                renderParallax();
                animatingPointer = false;
            }
        }

        let scrollRaf = false;
        window.addEventListener(
            'scroll',
            () => {
                scrollValue = window.scrollY || 0;
                if (!scrollRaf) {
                    window.requestAnimationFrame(() => {
                        renderParallax();
                        scrollRaf = false;
                    });
                    scrollRaf = true;
                }
            },
            { passive: true }
        );

        if (window.matchMedia && window.matchMedia('(hover: hover)').matches) {
            parallax.addEventListener(
                'pointermove',
                (e) => {
                    const rect = parallax.getBoundingClientRect();
                    targetX = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
                    targetY = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
                    if (!animatingPointer) {
                        animatingPointer = true;
                        window.requestAnimationFrame(tickPointer);
                    }
                },
                { passive: true }
            );

            parallax.addEventListener('pointerleave', () => {
                targetX = 0;
                targetY = 0;
                if (!animatingPointer) {
                    animatingPointer = true;
                    window.requestAnimationFrame(tickPointer);
                }
            });
        }

        renderParallax();
    })();
</script>
}
