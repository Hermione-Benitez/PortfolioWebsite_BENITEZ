@{
    ViewData["Title"] = "Portfolio";
    ViewData["Description"] = "Graphic design portfolio of Hermione Benitez: commissioned book covers and publication materials.";
}

@section Styles {
<style>
    body {
        background-color: #06020f;
        background-image: linear-gradient(180deg, rgba(6, 2, 15, 0.85), rgba(10, 4, 22, 0.94)), url('/images/bg.webp');
        background-size: cover;
        background-position: center top;
        background-attachment: fixed;
    }

    .portfolio-hero {
        position: relative;
        z-index: 2;
        padding: clamp(118px, 14vw, 152px) 20px 36px;
        text-align: center;
    }

    .filter-bar {
        display: inline-flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
        margin-top: 28px;
        padding: 7px;
        border-radius: 999px;
        background: rgba(18, 8, 36, 0.82);
        border: 1px solid rgba(208, 170, 255, 0.22);
        backdrop-filter: blur(14px);
    }

    .filter-btn {
        border: none;
        background: transparent;
        color: var(--text-secondary);
        font-size: 0.9rem;
        font-weight: 600;
        padding: 9px 18px;
        border-radius: 999px;
        cursor: pointer;
        transition: background-color 0.25s ease, color 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
    }

    .filter-btn:hover {
        color: #ffffff;
        background: rgba(168, 85, 247, 0.18);
    }

    .filter-btn.is-active {
        color: #ffffff;
        background: linear-gradient(135deg, #7b2cbf, #d946ef);
        box-shadow: 0 6px 20px rgba(168, 85, 247, 0.45);
    }

    .gallery-section {
        position: relative;
        z-index: 2;
        max-width: 1320px;
        margin: 0 auto;
        padding: 36px 24px 64px;
        transition: opacity 0.35s ease, transform 0.35s ease;
    }

    .gallery-section.is-hidden {
        display: none;
    }

    .gallery-section-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        margin-bottom: 30px;
        padding-bottom: 18px;
        border-bottom: 1px solid rgba(208, 170, 255, 0.14);
    }

    .gallery-section-header h2 {
        font-family: var(--font-display);
        font-size: clamp(1.7rem, 3.2vw, 2.4rem);
        font-weight: 800;
        margin: 10px 0 0;
    }

    .gallery-count-pill {
        padding: 6px 14px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(208, 170, 255, 0.24);
        color: var(--orchid-glow);
        font-size: 0.84rem;
        font-weight: 600;
    }

    .pubmats-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
        gap: 26px;
    }

    .work-card {
        display: flex;
        flex-direction: column;
        padding: 14px;
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
                    border-color 0.35s ease,
                    box-shadow 0.35s ease,
                    opacity 0.35s ease;
    }

    .work-trigger {
        position: relative;
        display: block;
        width: 100%;
        padding: 0;
        border: none;
        border-radius: 16px;
        overflow: hidden;
        background: radial-gradient(circle at center, rgba(99, 0, 165, 0.22), #080312 86%);
        border: 1px solid rgba(208, 170, 255, 0.14);
        cursor: pointer;
        aspect-ratio: 3 / 4;
    }

    .work-trigger--pubmat {
        aspect-ratio: 16 / 11;
    }

    .work-trigger img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 10px;
        display: block;
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .work-card:hover .work-trigger img {
        transform: scale(1.05);
    }

    .work-zoom-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 45%, rgba(8, 3, 18, 0.88) 100%);
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding: 16px;
        opacity: 0;
        transition: opacity 0.28s ease;
    }

    .work-card:hover .work-zoom-overlay,
    .work-trigger:focus-visible .work-zoom-overlay {
        opacity: 1;
    }

    .work-zoom-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 15px;
        border-radius: 999px;
        background: rgba(123, 44, 191, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: #ffffff;
        font-size: 0.8rem;
        font-weight: 700;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
    }

    .work-body {
        padding: 16px 8px 8px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex-grow: 1;
        text-align: left;
    }

    .work-tag-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 2px;
    }

    .work-tag {
        padding: 3px 10px;
        border-radius: 999px;
        background: rgba(168, 85, 247, 0.18);
        border: 1px solid rgba(208, 170, 255, 0.26);
        color: var(--orchid-glow);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .work-client {
        color: var(--magenta-flare);
        font-size: 0.84rem;
        font-weight: 600;
    }

    .work-body h3 {
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
        line-height: 1.3;
    }

    .work-body p {
        color: var(--text-secondary);
        font-size: 0.9rem;
        line-height: 1.55;
        margin: 4px 0 0;
    }

    /* Full-width disclaimer & external credits banner */
    .disclaimer-banner {
        margin-top: 32px;
        padding: 26px 28px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        text-align: left;
    }

    .disclaimer-copy {
        max-width: 680px;
    }

    .disclaimer-copy h3 {
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 6px;
    }

    .disclaimer-copy p {
        color: var(--text-secondary);
        font-size: 0.92rem;
        margin: 0;
        line-height: 1.6;
    }

    .disclaimer-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    @@media (max-width: 600px) {
        .filter-bar {
            border-radius: 22px;
            width: 100%;
            max-width: 380px;
        }

        .filter-btn {
            flex: 1 1 auto;
            text-align: center;
        }

        .gallery-section {
            padding: 24px 16px 48px;
        }

        .disclaimer-banner {
            text-align: center;
            justify-content: center;
        }

        .disclaimer-actions {
            justify-content: center;
        }
    }
</style>
}

