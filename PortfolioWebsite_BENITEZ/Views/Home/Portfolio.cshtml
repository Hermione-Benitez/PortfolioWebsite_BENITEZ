@section Scripts {
<script>
    (() => {
        const filterBtns = document.querySelectorAll('.filter-btn');
        const sections = document.querySelectorAll('[data-gallery-section]');
        if (!filterBtns.length || !sections.length) return;

        filterBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
                const filter = btn.getAttribute('data-filter');

                filterBtns.forEach((b) => {
                    const active = b === btn;
                    b.classList.toggle('is-active', active);
                    b.setAttribute('aria-selected', active ? 'true' : 'false');
                });

                sections.forEach((sec) => {
                    const key = sec.getAttribute('data-gallery-section');
                    const show = filter === 'all' || filter === key;
                    sec.classList.toggle('is-hidden', !show);

                    sec.querySelectorAll('[data-work-card]').forEach((card) => {
                        card.classList.toggle('is-filtered-out', !show);
                        if (show) {
                            card.classList.add('is-visible');
                        }
                    });
                });
            });
        });
    })();
</script>
}
