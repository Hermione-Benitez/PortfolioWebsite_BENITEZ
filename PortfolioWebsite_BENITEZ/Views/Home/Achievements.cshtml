@{
    ViewData["Title"] = "Experiences & Achievements";
    ViewData["Description"] = "Academic organizational roles, leadership experiences, projects, and awards of Hermione Benitez.";
}

@section Styles {
<style>
    body {
        background-color: #06020f;
        color: #ffffff;
    }

    .bg-video {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background-color: #06020f;
        z-index: 0;
        pointer-events: none;
    }

    .bg-video video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.45;
    }

    .bg-video::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse at 50% 20%, rgba(123, 44, 191, 0.25), transparent 65%),
            linear-gradient(180deg, rgba(6, 2, 15, 0.72) 0%, rgba(10, 4, 24, 0.65) 50%, rgba(6, 2, 15, 0.88) 100%);
    }

    .achievements-hero {
        position: relative;
        z-index: 2;
        padding: clamp(118px, 14vw, 150px) 20px 36px;
        text-align: center;
    }

    .achievements-hero-stats {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin: 24px auto 28px;
    }

    .stat-chip {
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(19, 9, 38, 0.78);
        border: 1px solid rgba(208, 170, 255, 0.24);
        backdrop-filter: blur(12px);
        color: #f3e8ff;
        font-size: 0.86rem;
        font-weight: 600;
    }

    .section-jump-pills {
        display: inline-flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        padding: 6px;
        border-radius: 999px;
        background: rgba(18, 8, 36, 0.75);
        border: 1px solid rgba(208, 170, 255, 0.2);
        backdrop-filter: blur(14px);
    }

    .jump-pill {
        padding: 9px 20px;
        border-radius: 999px;
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
    }

    .jump-pill:hover,
    .jump-pill--primary {
        background: linear-gradient(135deg, rgba(123, 44, 191, 0.72), rgba(217, 70, 239, 0.45));
        color: #ffffff;
    }

    /* ===== TIMELINE SECTIONS ===== */
    .timeline-section {
        position: relative;
        z-index: 2;
        max-width: 1180px;
        margin: 28px auto 70px;
        padding: clamp(32px, 4vw, 52px) clamp(16px, 3vw, 40px);
        border-radius: 28px;
        background: rgba(14, 6, 28, 0.62);
        border: 1px solid rgba(208, 170, 255, 0.16);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
        overflow: hidden;
        scroll-margin-top: 88px;
    }

    .timeline-header {
        text-align: center;
        margin-bottom: 46px;
    }

    .timeline-header h2 {
        font-family: var(--font-display);
        font-size: clamp(1.65rem, 3.2vw, 2.4rem);
        font-weight: 800;
        margin: 12px 0 8px;
    }

    .timeline-header p {
        color: var(--text-secondary);
        font-size: 0.96rem;
        margin: 0;
    }

    .card-container {
        position: relative;
        padding: 10px 0 18px;
    }

    /* Animated central spine (preserving moveline motion) */
    .card-container::before {
        content: "";
        position: absolute;
        top: 12px;
        bottom: 12px;
        left: 50%;
        width: 4px;
        transform: translateX(-50%);
        background: rgba(208, 170, 255, 0.14);
        border-radius: 999px;
    }

    .card-container::after {
        content: "";
        position: absolute;
        top: 12px;
        left: 50%;
        width: 4px;
        height: 0;
        transform: translateX(-50%);
        background: linear-gradient(180deg, #e056fd 0%, #a855f7 55%, #6ee7ff 100%);
        border-radius: 999px;
        box-shadow: 0 0 18px rgba(208, 170, 255, 0.65);
        z-index: 1;
    }

    .timeline-section.is-visible .card-container::after {
        animation: moveline 2.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @@keyframes moveline {
        0% {
            height: 0;
        }
        100% {
            height: calc(100% - 24px);
        }
    }

    .timeline-row {
        position: relative;
        display: flex;
        align-items: flex-start;
        margin-bottom: 28px;
    }

    .timeline-row:last-child {
        margin-bottom: 0;
    }

    .timeline-row--left {
        justify-content: flex-start;
    }

    .timeline-row--right {
        justify-content: flex-end;
    }

    .timeline-node {
        position: absolute;
        left: 50%;
        top: 26px;
        transform: translateX(-50%);
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6300a5, #c026d3);
        border: 3px solid rgba(255, 255, 255, 0.85);
        color: #ffffff;
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 4;
        box-shadow: 0 0 22px rgba(208, 170, 255, 0.55);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .timeline-row:hover .timeline-node,
    .timeline-row.is-in-focus .timeline-node {
        transform: translateX(-50%) scale(1.16);
        box-shadow: 0 0 0 8px rgba(208, 170, 255, 0.16), 0 0 34px rgba(224, 86, 253, 0.9);
    }

    .timeline-row.is-in-focus .info-card {
        border-color: rgba(212, 165, 255, 0.52);
        box-shadow: 0 22px 54px rgba(8, 2, 22, 0.78), 0 0 38px rgba(168, 85, 247, 0.28);
    }

    .info-card {
        width: calc(50% - 44px);
        padding: 24px 26px;
        text-align: left;
    }

    .timeline-badge {
        display: inline-block;
        padding: 4px 11px;
        border-radius: 999px;
        background: rgba(168, 85, 247, 0.2);
        border: 1px solid rgba(208, 170, 255, 0.3);
        color: var(--orchid-glow);
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .info-card h3 {
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 8px;
        line-height: 1.3;
    }

    .info-card p {
        color: var(--text-secondary);
        font-size: 0.94rem;
        line-height: 1.6;
        margin: 0;
    }

    .timeline-cta-banner {
        position: relative;
        z-index: 2;
        max-width: 1180px;
        margin: 0 auto 90px;
        padding: 36px 28px;
        text-align: center;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .timeline-cta-banner h3 {
        font-family: var(--font-display);
        font-size: 1.45rem;
        font-weight: 800;
        margin: 0 0 4px;
        text-align: left;
    }

    .timeline-cta-banner p {
        color: var(--text-secondary);
        margin: 0;
        text-align: left;
    }

    @@media (max-width: 820px) {
        .timeline-section {
            margin: 20px 14px 48px;
            padding: 28px 16px;
        }

        .card-container::before,
        .card-container::after {
            left: 20px;
            transform: none;
        }

        .timeline-row,
        .timeline-row--left,
        .timeline-row--right {
            justify-content: flex-end;
        }

        .timeline-node {
            left: 20px;
            width: 36px;
            height: 36px;
            font-size: 0.88rem;
            top: 22px;
        }

        .info-card {
            width: calc(100% - 54px);
            padding: 20px;
        }

        .timeline-cta-banner {
            margin: 0 14px 70px;
            justify-content: center;
            text-align: center;
        }

        .timeline-cta-banner h3,
        .timeline-cta-banner p {
            text-align: center;
        }
    }
</style>
}

