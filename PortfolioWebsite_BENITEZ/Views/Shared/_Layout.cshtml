<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hermione Benitez</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Portfolio website of Hermione Benitez — BSIT student, UI/UX Designer, Graphic Designer, and Frontend Developer.")" />
    <meta property="og:title" content="@ViewData["Title"] - Hermione Benitez" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Portfolio website of Hermione Benitez — BSIT student, UI/UX Designer, Graphic Designer, and Frontend Developer.")" />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PortfolioWebsite_BENITEZ.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="scroll-progress" aria-hidden="true"></div>

    <header>
        <nav class="navbar navbar-expand-md navbar-dark site-navbar fixed-top" aria-label="Primary navigation">
            <div class="container-fluid">
                <a class="navbar-brand-lockup" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo-wrap">
                        <img src="~/images/Yunii.png" alt="Yunii logo" class="brand-logo" />
                    </span>
                    <span class="brand-text-group">
                        <span class="brand-title">Hermione Benitez</span>
                        <span class="brand-sub">Portfolio Website</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-md-center">
                        <li class="nav-item">
                            <a class="nav-link" data-nav="about" asp-controller="Home" asp-action="Index">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-nav="experiences" asp-controller="Home" asp-action="Achievements">Experiences</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-nav="portfolio" asp-controller="Home" asp-action="Portfolio">Portfolio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-nav="contact" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-grid">
            <div class="footer-col footer-brand-col">
                <a class="navbar-brand-lockup" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo-wrap">
                        <img src="~/images/Yunii.png" alt="Yunii logo" class="brand-logo" />
                    </span>
                    <span class="brand-text-group">
                        <span class="brand-title">Hermione Benitez</span>
                        <span class="brand-sub">Yuni Graphics</span>
                    </span>
                </a>
                <p>BSIT student, Graphic &amp; UI/UX Designer, and Developer crafting thoughtful visual narratives and functional web experiences.</p>
                <div class="footer-social-row">
                    <a class="social-pill-btn" href="https://www.linkedin.com/in/hermione-benitez-934335334/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M19 3A2 2 0 0 1 21 5V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V5A2 2 0 0 1 5 3H19M18.5 18.5V13.2A3.26 3.26 0 0 0 15.24 9.94C14.39 9.94 13.4 10.46 12.92 11.24V10.13H10.13V18.5H12.92V13.57C12.92 12.8 13.54 12.17 14.31 12.17A1.4 1.4 0 0 1 15.71 13.57V18.5H18.5M6.88 8.56A1.68 1.68 0 0 0 8.56 6.88C8.56 5.95 7.81 5.19 6.88 5.19A1.69 1.69 0 0 0 5.19 6.88C5.19 7.81 5.95 8.56 6.88 8.56M8.27 18.5V10.13H5.5V18.5H8.27Z"/>
                        </svg>
                    </a>
                    <a class="social-pill-btn" href="https://github.com/Hermione-Benitez" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/>
                        </svg>
                    </a>
                    <a class="social-pill-btn" href="https://www.facebook.com/lekantier.jinpier" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 2.04c-5.5 0-10 4.49-10 10.02c0 5 3.66 9.15 8.44 9.9v-7H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.89 3.78-3.89c1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33v7a10 10 0 0 0 8.44-9.9c0-5.53-4.5-10.02-10-10.02Z"/>
                        </svg>
                    </a>
                </div>
            </div>

            <div class="footer-col">
                <h3>Navigation</h3>
                <ul class="footer-links-list">
                    <li><a asp-controller="Home" asp-action="Index">About</a></li>
                    <li><a asp-controller="Home" asp-action="Achievements">Experiences &amp; Awards</a></li>
                    <li><a asp-controller="Home" asp-action="Portfolio">Design Portfolio</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Contact &amp; Resume</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Portfolio Focus</h3>
                <ul class="footer-links-list">
                    <li><span>UI/UX &amp; Frontend Design</span></li>
                    <li><span>Graphic Design &amp; Book Covers</span></li>
                    <li><span>Leadership &amp; System Architecture</span></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Get In Touch</h3>
                <ul class="footer-links-list">
                    <li><span>Quezon City, Metro Manila, Philippines</span></li>
                    <li><a class="footer-contact-link" href="mailto:benitezhermione@gmail.com">benitezhermione@gmail.com</a></li>
                    <li><a class="footer-contact-link" href="tel:+639396204267">(+63) 939 620 4267</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <span>&copy; 2025 Hermione B. Benitez. All Rights Reserved.</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        </div>
    </footer>

    <button type="button" class="back-to-top" aria-label="Back to top">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 15l-6-6-6 6"></path>
        </svg>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
