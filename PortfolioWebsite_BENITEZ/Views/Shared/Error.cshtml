@{
    var statusCode = (int?)ViewData["StatusCode"] ?? 500;
    var isNotFound = statusCode == 404;
    ViewData["Title"] = isNotFound ? "Page Not Found" : "Error";
}

@section Styles {
<style>
    html, body {
        background-color: #0d001a;
        color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .error-container {
        min-height: 85vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 120px 20px 60px;
    }

    .error-code {
        font-size: clamp(4rem, 12vw, 7rem);
        font-weight: 900;
        color: #d0aaff;
        line-height: 1;
        margin-bottom: 16px;
    }

    .error-message {
        font-size: 1.25rem;
        color: #ccc;
        max-width: 520px;
        margin-bottom: 32px;
    }

    .error-home-btn {
        display: inline-block;
        padding: 12px 28px;
        border-radius: 50px;
        background-color: #6300a5;
        color: #ffffff;
        text-decoration: none;
        font-weight: 600;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .error-home-btn:hover {
        background-color: #7c1ec2;
        color: #ffffff;
        transform: translateY(-2px);
    }
</style>
}

<section class="error-container">
    <div class="error-code">@statusCode</div>
    <h1>@(isNotFound ? "Page Not Found" : "Something Went Wrong")</h1>
    <p class="error-message">
        @(isNotFound
            ? "The page you are looking for doesn't exist or has been moved."
            : "An unexpected error occurred while processing your request.")
    </p>
    <a class="error-home-btn" asp-controller="Home" asp-action="Index">Back to Home</a>
</section>

